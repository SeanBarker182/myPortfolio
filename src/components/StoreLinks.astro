---
import type { CollectionEntry } from 'astro:content';
import Sticker from './Sticker.astro';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { links, status } = project.data;
---

<div class="flex flex-wrap gap-3.5">
  {links.appStore && (
    <a href={links.appStore} class="btn btn-primary hd" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
      App Store
    </a>
  )}
  {links.playStore && (
    <a href={links.playStore} class="btn hd3" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 4l14 8-14 8z"></path></svg>
      Play Store
    </a>
  )}
  {links.download && (
    <a href={links.download} class="btn btn-primary hd" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
      Download for Mac
    </a>
  )}
  {links.writeup && <a href={links.writeup} class="btn btn-primary hd">Read the writeup</a>}
  {links.site && <a href={links.site} class="btn hd2" rel="noopener">Project site</a>}
  {status === 'soon' && !links.appStore && !links.download && <Sticker accent tilt={-2}>coming soon</Sticker>}
</div>
