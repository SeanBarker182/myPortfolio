---
/** The about-page illustration: a laptop, a phone and an ESP32. Kept simple on purpose. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---

<svg
  class:list={['wob', cls]}
  viewBox="0 0 480 320"
  role="img"
  aria-label="Sketch of a laptop and a phone showing colorful apps, with an ESP32 board in front"
  fill="none"
  stroke="var(--ink)"
  stroke-width="5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- ground -->
  <path d="M20 296 q110 10 220 0 t220 0" stroke-width="6"></path>

  <!-- laptop -->
  <rect x="70" y="60" width="270" height="180" rx="14" fill="var(--paper)"></rect>
  <path d="M50 250 h310 l-16 26 h-278 z" fill="var(--paper)"></path>
  <rect x="86" y="76" width="238" height="148" rx="8" fill="#2563eb" stroke="none"></rect>
  <rect x="102" y="94" width="90" height="12" rx="6" fill="#fff" opacity=".85" stroke="none"></rect>
  <rect x="102" y="118" width="206" height="46" rx="10" fill="#fff" opacity=".35" stroke="none"></rect>
  <rect x="102" y="174" width="96" height="36" rx="10" fill="#fff" opacity=".35" stroke="none"></rect>
  <rect x="212" y="174" width="96" height="36" rx="10" fill="#fff" opacity=".35" stroke="none"></rect>

  <!-- phone, leaning on the laptop -->
  <rect x="358" y="118" width="86" height="172" rx="18" fill="var(--paper)"></rect>
  <rect x="368" y="132" width="66" height="144" rx="10" fill="#0d9488" stroke="none"></rect>
  <rect x="378" y="148" width="40" height="8" rx="4" fill="#fff" opacity=".85" stroke="none"></rect>
  <rect x="378" y="166" width="46" height="40" rx="8" fill="#fff" opacity=".35" stroke="none"></rect>
  <rect x="378" y="214" width="46" height="40" rx="8" fill="#fff" opacity=".35" stroke="none"></rect>

  <!-- ESP32 on the bench in front -->
  <rect x="150" y="262" width="110" height="30" rx="5" fill="var(--paper)"></rect>
  <rect x="162" y="270" width="18" height="14" rx="3" stroke-width="3"></rect>
  <path d="M190 269 h30 M190 277 h30 M190 285 h30" stroke-width="3"></path>
  <path d="M232 266 v22 M240 266 v22 M248 266 v22" stroke-width="3"></path>
  <circle cx="156" cy="268" r="2" fill="var(--ink)" stroke="none"></circle>

  <!-- sparkles -->
  <path d="M30 40 l16 16 M64 30 v22 M20 76 h22" stroke="var(--accent)" stroke-width="5"></path>
  <path d="M450 56 l-16 16 M416 46 v22 M460 92 h-22" stroke="var(--accent)" stroke-width="5"></path>
</svg>
