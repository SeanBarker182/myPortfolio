---
/** The Summit Labs bars, from the Summit Labs design system, without the outer frame. */
interface Props { class?: string; title?: string }
const { class: cls = '', title = 'Summit Labs' } = Astro.props;
---

<svg class={cls} viewBox="12 12 76 76" role="img" aria-label={title}>
  <rect x="14" y="14" width="31" height="26" rx="7" fill="#E5231C"></rect>
  <rect x="14" y="45" width="31" height="41" rx="7" fill="#1246E3"></rect>
  <rect x="55" y="29" width="31" height="57" rx="7" fill="#F6C513"></rect>
</svg>
