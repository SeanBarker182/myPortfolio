---
import InfiniteRed from './InfiniteRed.astro';
import Reusser from './Reusser.astro';
import Apple from './Apple.astro';
import SummitLabs from './SummitLabs.astro';

export type LogoKey = 'infinite-red' | 'reusser' | 'apple' | 'summit-labs';

interface Props {
  logo: LogoKey;
  company: string;
  /** Box size in px. */
  size?: number;
  class?: string;
}
const { logo, company, size = 44, class: cls = '' } = Astro.props;
const map = { 'infinite-red': InfiniteRed, reusser: Reusser, apple: Apple, 'summit-labs': SummitLabs };
const Mark = map[logo];
// Marks with their own frame (Summit Labs) sit flush; the others get a little breathing room.
const pad = logo === 'summit-labs' || logo === 'reusser' ? 0 : Math.round(size * 0.18);
---

<span class:list={['inline-flex shrink-0 items-center justify-center text-ink', cls]} style={`width:${size}px;height:${size}px;padding:${pad}px`}>
  <Mark class="h-full w-full" title={company} />
</span>
