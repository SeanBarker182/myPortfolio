---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: cls = '' } = Astro.props;
---

<svg
  class:list={['wob shrink-0', cls]}
  width={size}
  height={size}
  viewBox="0 0 34 34"
  fill="none"
  stroke="var(--ink)"
  stroke-width="3"
  stroke-linecap="round"
  aria-hidden="true"
>
  <rect x="3" y="3" width="28" height="28" rx="9" fill="var(--paper)"></rect>
  <path d="M11 21c2 3 10 3 12 0M11 13h.5M22.5 13h.5"></path>
</svg>
