---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Apps and products Sean Barker has shipped: JAM Center, Abrupt, Polaris, Big Fort Fest, Threadyard." og="/og/work.png">
  <section class="mt-16 flex flex-col gap-8">
    <div class="flex flex-col gap-3">
      <h1 class="font-hand text-7xl leading-none font-bold sm:text-8xl">Things I shipped</h1>
      <p class="max-w-[620px] text-xl leading-relaxed opacity-85">Product through store submission. Every one of these started as "we need an app for that."</p>
    </div>
    <div class="grid grid-cols-1 gap-7 md:grid-cols-2">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>
</Base>
