---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
import { resume } from '@/data/resume';
import CompanyLogo from '@/components/logos/CompanyLogo.astro';
---

<Base title="Resume" description={`Resume for ${site.name}, ${site.role}.`} og="/og/resume.png">
  <div class="mt-16 flex flex-col gap-12 print:mt-0 print:gap-6">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-2">
        <h1 class="font-hand text-7xl leading-none font-bold sm:text-8xl print:text-5xl">{site.name}</h1>
        <div class="text-xl font-semibold">{site.role} · {site.location}</div>
        <div class="font-mono text-sm opacity-75">
          <a href={`mailto:${site.email}`} class="text-link">{site.email}</a> · <a href={site.url} class="text-link">seanbarker.dev</a> · <a href={site.social.linkedin} class="text-link">LinkedIn</a> · <a href={site.social.github} class="text-link">GitHub</a>
        </div>
      </div>
      <button type="button" class="btn hd2 print:hidden" onclick="window.print()">Save as PDF</button>
    </header>

    <p class="max-w-[760px] text-xl leading-relaxed">{resume.summary}</p>

    <section class="flex flex-col gap-6">
      <h2 class="font-hand text-5xl leading-none font-bold print:text-3xl">Experience</h2>
      {resume.experience.map((job) => (
        <div class="hd flex flex-col gap-2 px-7 py-6 print:border-0 print:px-0 print:py-2">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <CompanyLogo logo={job.logo} company={job.company} size={44} />
              <div class="text-xl font-extrabold">{job.title} <span class="font-semibold opacity-70">· {job.company}</span></div>
            </div>
            <div class="font-mono text-[13px] opacity-65">{job.start} to {job.end} · {job.location}</div>
          </div>
          <ul class="list-disc pl-6 text-[17px] leading-relaxed">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="flex flex-col gap-5">
      <h2 class="font-hand text-5xl leading-none font-bold print:text-3xl">Skills</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 print:grid-cols-2">
        {resume.skills.map((s) => (
          <div class="flex flex-col gap-1">
            <div class="font-mono text-xs tracking-[.08em] uppercase opacity-65">{s.group}</div>
            <div class="text-[17px] leading-relaxed">{s.items.join(' · ')}</div>
          </div>
        ))}
      </div>
    </section>

    {resume.education.length > 0 && (
      <section class="flex flex-col gap-4">
        <h2 class="font-hand text-5xl leading-none font-bold print:text-3xl">Education</h2>
        {resume.education.map((e) => (
          <div class="text-[17px]"><strong>{e.degree}</strong>, {e.school} · {e.year}</div>
        ))}
      </section>
    )}

    <section class="flex flex-col gap-5 print:hidden">
      <h2 class="font-hand text-5xl leading-none font-bold">Kind words</h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {resume.recommendations.map((r, i) => (
          <blockquote class:list={['m-0 flex flex-col gap-3 px-7 py-6', i % 2 ? 'hd3' : 'hd2']}>
            <p class="m-0 text-[17px] leading-relaxed">“{r.quote}”</p>
            <footer class="text-sm opacity-70"><strong>{r.from}</strong> · {r.role}</footer>
          </blockquote>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="font-hand text-5xl leading-none font-bold print:text-3xl">Certifications</h2>
      <ul class="flex flex-col gap-1.5 text-[17px]">
        {resume.certifications.map((c) => (
          <li><strong>{c.name}</strong> · {c.issuer}, {c.year}</li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style is:global>
  @media print {
    @page { margin: 0.6in; }
    header, footer, nav, .wob { display: none !important; }
    html { background: #fff; color: #111; }
    body { font-size: 11pt; }
  }
</style>
