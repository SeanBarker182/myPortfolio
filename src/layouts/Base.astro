---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image for this page, defaults to the home one. */
  og?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, og = '/og/home.png', canonical, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const url = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(og, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ?? url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Blog`} href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@seanbarkerdev" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />
    <Font cssVariable="--font-caveat" preload />
    <Font cssVariable="--font-figtree" preload />
    <Font cssVariable="--font-jetbrains" />
    <ClientRouter />
    <Analytics />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="wob">
        <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="11"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
      </filter>
    </svg>
    <div class="mx-auto max-w-[1120px] px-4 pt-6 pb-16 sm:px-6">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Draw-on reveal: sections fade up the first time they enter view.
      function arm() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.in)');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach((e) => e.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                io.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((e) => io.observe(e));
      }
      // Kids' ages: computed at build, corrected at runtime so they never go stale.
      function ages() {
        const now = new Date();
        document.querySelectorAll<HTMLElement>('[data-born]').forEach((el) => {
          const b = new Date(el.dataset.born!);
          let a = now.getFullYear() - b.getFullYear();
          if (now.getMonth() < b.getMonth() || (now.getMonth() === b.getMonth() && now.getDate() < b.getDate())) a--;
          el.textContent = String(a);
        });
      }
      arm();
      ages();
      document.addEventListener('astro:page-load', () => {
        arm();
        ages();
      });
    </script>
  </body>
</html>
