# Copy to .env for local development. In production, set these in Vercel.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=theseanbarker@gmail.com
# A verified sender on your Resend domain, e.g. hello@seanbarker.dev
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
